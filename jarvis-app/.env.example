# --- Core ---
# Managed Postgres (Supabase/Neon). Run db/schema.sql once, then db/seed.sql for demo data.
DATABASE_URL=postgres://user:password@host:5432/jarvis

# --- AI provider (set ONE of the two keys) ---
# OpenRouter (openrouter.ai) — lets you swap models freely via AI_MODEL.
OPENROUTER_API_KEY=
# Or Anthropic direct (console.anthropic.com).
ANTHROPIC_API_KEY=
# Model id. OpenRouter examples: anthropic/claude-sonnet-4.5, openai/gpt-4o.
# Anthropic-direct example: claude-sonnet-5. Without any key set, Jarvis shows raw data (no AI).
AI_MODEL=anthropic/claude-sonnet-4.5

# --- Auth (required for any deployed instance) ---
# Password for the login screen. Unset = auth disabled (local dev only).
APP_PASSWORD=
# Random string used to sign the session cookie (e.g. `openssl rand -hex 32`).
SESSION_SECRET=
# Lets Vercel Cron call /api/ingest on a schedule without a browser session.
CRON_SECRET=

# --- Multi-instance (optional) ---
# Postgres schema for this instance (default: jarvis). A public demo instance
# should use its own schema, e.g. jarvis_demo, plus DEMO_MODE=1 (disables auth).
JARVIS_SCHEMA=
DEMO_MODE=

# --- Connectors (fill in as you wire each one; all read-only) ---
# Obsidian bridge (OPTIONAL): absolute path to a synced copy of your vault
OBSIDIAN_VAULT_PATH=

# Microsoft Graph (Outlook mail + calendar)
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_TENANT_ID=
MS_GRAPH_REFRESH_TOKEN=

# Zoho Books (ZOHO_DC = your data center TLD: com | in | eu | com.au | jp)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=
ZOHO_DC=in

# Coda
CODA_API_TOKEN=
