# --- Core ---
# Managed Postgres (Supabase/Neon). Run db/schema.sql once, then db/seed.sql for demo data.
DATABASE_URL=postgres://user:password@host:5432/jarvis

# --- AI provider (set ONE of the two keys) ---
# OpenRouter (openrouter.ai) — lets you swap models freely via AI_MODEL.
OPENROUTER_API_KEY=
# Or Anthropic direct (console.anthropic.com).
ANTHROPIC_API_KEY=
# Model id. OpenRouter examples: anthropic/claude-sonnet-4.5, openai/gpt-4o.
# Anthropic-direct example: claude-sonnet-5. Without any key set, Jarvis shows raw data (no AI).
AI_MODEL=anthropic/claude-sonnet-4.5

# --- Auth (required for any deployed instance) ---
# Password for the login screen. Unset = auth disabled (local dev only).
APP_PASSWORD=
# Random string used to s