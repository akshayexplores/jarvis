# --- Core ---
# Managed Postgres (Supabase/Neon). Run db/schema.sql once, then db/seed.sql for demo data.
DATABASE_URL=postgres://user:password@host:5432/jarvis

# Claude API key (console.anthropic.com). Without it, Jarvis falls back to raw data views (no AI summaries).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Connectors (fill in as you wire each one; all read-only) ---
# Obsidian bridge: absolute path to a synced copy of your vault (works out of the box)
OBSIDIAN_VAULT_PATH=

# Microsoft Graph (Outlook mail + calendar)
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_TENANT_ID=
MS_GRAPH_REFRESH_TOKEN=

# Zoho Books
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=

# Coda
CODA_API_TOKEN=
